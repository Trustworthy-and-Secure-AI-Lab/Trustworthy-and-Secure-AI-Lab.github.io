---
const navigation = [
  {
    "href": "/about/",
    "label": "About"
  },
  {
    "href": "/research/",
    "label": "Research"
  },
  {
    "href": "/people/",
    "label": "People"
  },
  {
    "href": "/publications/",
    "label": "Publications"
  },
  {
    "href": "/teaching/",
    "label": "Teaching"
  },
  {
    "href": "/join/",
    "label": "Join Us"
  }
];
---
<header>
      <div class="wrap">
        <div class="nav">
          <a class="brand" href="/"
            ><span class="brand-mark"
              ><svg viewBox="0 0 100 100" aria-hidden="true">
                <circle cx="24" cy="24" r="16" fill="#111" />
                <circle cx="76" cy="24" r="16" fill="#111" />
                <ellipse
                  cx="50"
                  cy="55"
                  rx="38"
                  ry="36"
                  fill="white"
                  stroke="#111"
                  stroke-width="3"
                />
                <ellipse
                  cx="34"
                  cy="51"
                  rx="11"
                  ry="15"
                  transform="rotate(25 34 51)"
                  fill="#111"
                />
                <ellipse
                  cx="66"
                  cy="51"
                  rx="11"
                  ry="15"
                  transform="rotate(-25 66 51)"
                  fill="#111"
                />
                <circle cx="36" cy="48" r="3" fill="white" />
                <circle cx="64" cy="48" r="3" fill="white" />
                <path d="M43 65Q50 61 57 65L50 72Z" fill="#111" />
                <path
                  d="M50 72v5m-10 0q10 9 20 0"
                  fill="none"
                  stroke="#111"
                  stroke-width="3"
                  stroke-linecap="round"
                /></svg
              ><img
                src="/images/lab-logo.png" width="44" height="44"
                alt=" Lab panda logo"
                onerror="this.hidden = true"
                onload="
                  this.previousElementSibling.style.display = 'none'
                " /></span
            ><span class="brand-copy"><span class="brand-name">TSAIL</span><span class="brand-university">Sharif University of Technology</span></span></a
          >
          <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
            Menu
          </button>
          <nav id="primary-navigation" class="primary-nav" aria-label="Main navigation">
            {navigation.map(({ href, label }) => (
              <a href={href} aria-current={Astro.url.pathname === href ? 'page' : undefined}>{label}</a>
            ))}
          </nav>
        </div>
      </div>
    </header>

<script>
  const header = document.querySelector<HTMLElement>('header');
  const row = header?.querySelector<HTMLElement>('.nav');
  const brand = header?.querySelector<HTMLElement>('.brand');
  const toggle = header?.querySelector<HTMLButtonElement>('.nav-toggle');
  const navigation = header?.querySelector<HTMLElement>('.primary-nav');
  if (header && row && brand && toggle && navigation) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      navigation.classList.toggle('is-open', open);
    };
    const updateLayout = () => {
      const wasCompact = header.classList.contains('nav-compact');
      header.classList.add('nav-measuring');
      const gap = parseFloat(getComputedStyle(row).columnGap) || 0;
      const requiredWidth = brand.getBoundingClientRect().width + navigation.getBoundingClientRect().width + gap;
      header.classList.remove('nav-measuring');
      const compact = row.clientWidth < requiredWidth;
      header.classList.toggle('nav-compact', compact);
      if (compact !== wasCompact) {
        setOpen(false);
        if (compact && navigation.contains(document.activeElement)) toggle.focus();
        if (!compact && document.activeElement === toggle) navigation.querySelector<HTMLAnchorElement>('a')?.focus();
      }
    };
    header.classList.add('nav-ready');
    updateLayout();
    let lastWidth = -1;
    new ResizeObserver(([entry]) => {
      if (entry.contentRect.width === lastWidth) return;
      lastWidth = entry.contentRect.width;
      updateLayout();
    }).observe(row);
    document.fonts.ready.then(updateLayout);
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    header.addEventListener('keydown', event => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
    header.addEventListener('focusout', event => {
      if (event.relatedTarget instanceof Node && !header.contains(event.relatedTarget)) setOpen(false);
    });
    document.addEventListener('click', event => {
      if (event.target instanceof Node && !header.contains(event.target)) setOpen(false);
    });
  }
</script>
