---
import SiteLayout from '../layouts/SiteLayout.astro';
import people from '../data/people.json';

interface Student {
  name: string;
  topic: string;
  photo?: string;
}
interface StudentGroup {
  title: string;
  id: string;
  students: Student[];
}
const groups: StudentGroup[] = people;

function initials(name: string) {
  const parts = name.trim().split(/\s+/).filter(Boolean);
  return [parts[0], parts.length > 1 ? parts[parts.length - 1] : '']
    .map(part => Array.from(part ?? '')[0] ?? '')
    .join('').toLocaleUpperCase();
}
---
<SiteLayout title="People">
  <section id="people">
    <div class="wrap">
      <h1 class="section-title">People</h1>
      <div class="people-group" aria-labelledby="pi-title">
        <h2 id="pi-title">Principal Investigator</h2>
        <article class="pi-profile">
          <div class="pi-portrait">
            <span aria-hidden="true">AMS</span>
            <img
              src="/images/amir-mahdi-sadeghzadeh.png"
              alt="Amir Mahdi Sadeghzadeh"
              width="200"
              height="200"
              onerror="this.hidden = true"
            />
          </div>
          <div class="pi-copy">
            <h3>Dr. Amir Mahdi Sadeghzadeh</h3>
            <p class="pi-role">Assistant Professor</p>
            <p class="pi-affiliation"><strong>Office:</strong> Room 718, Department of Computer Engineering, Sharif University of Technology<br />
              <strong>Office Hours:</strong> By appointment (through email)<br />
              <strong>Email:</strong> <a href="mailto:amsadeghzadeh@gmail.com">amsadeghzadeh@gmail.com</a>
            </p>
            <p class="pi-bio">
              <a class="scholar-link" href="https://scholar.google.com/citations?user=SndfdlwAAAAJ&amp;hl=en">
                Google Scholar
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M7 17 17 7M7 7h10v10" />
                </svg>
              </a>
            </p>
          </div>
        </article>
      </div>
      {groups.filter(group => group.students.length > 0).map(({ title, id, students }) => (
        <div class="people-group" aria-labelledby={id}>
          <h2 id={id}>{title}</h2>
          <ul class="members-grid" role="list">
            {students.map(({ name, topic, photo }) => (
              <li class="member">
                <div class="member-avatar">
                  <span aria-hidden="true">{initials(name)}</span>
                  {photo && (
                    <img
                      src={photo}
                      alt={name}
                      width="200"
                      height="200"
                      loading="lazy"
                      decoding="async"
                      onerror="this.hidden = true"
                    />
                  )}
                </div>
                <div class="member-copy">
                  <h3>{name}</h3>
                  <p>{topic}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
</SiteLayout>

<style>
  .people-group + .people-group {
    margin-top: 48px;
  }
  .people-group h2 {
    margin: 0 0 24px;
    font-size: 22px;
    font-weight: 650;
    line-height: 1.4;
    letter-spacing: -0.025em;
  }
  .pi-profile {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: 32px;
    align-items: center;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--paper);
  }
  .pi-portrait,
  .member-avatar {
    position: relative;
    overflow: hidden;
    display: grid;
    place-items: center;
    width: 200px;
    max-width: 100%;
    aspect-ratio: 1;
    border-radius: 12px;
    background: #087e780a;
    color: var(--accent);
    font-size: 30px;
    font-weight: 500;
    letter-spacing: 0.03em;
  }
  .pi-portrait img,
  .member-avatar img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pi-portrait img[hidden],
  .member-avatar img[hidden] {
    display: none;
  }
  .pi-copy {
    min-width: 0;
    max-width: 640px;
  }
  .pi-copy h3 {
    margin: 0 0 6px;
    font-size: clamp(22px, 2.5vw, 28px);
    font-weight: 650;
    letter-spacing: -0.03em;
  }
  .pi-role {
    color: var(--accent);
    font-size: 13px;
    font-weight: 600;
    margin: 0 0 12px;
  }
  .pi-affiliation,
  .pi-bio {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.8;
    margin: 0;
  }
  .pi-bio {
    margin-top: 12px;
  }
  .members-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .member {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    min-width: 0;
    padding: 24px 20px;
    border: 1px solid var(--line);
    border-radius: 14px;
    text-align: center;
    background: var(--bg);
  }
  .member-copy {
    min-width: 0;
    max-width: 30ch;
    overflow-wrap: anywhere;
  }
  .member h3 {
    margin: 0 0 7px;
    font-size: 17px;
    font-weight: 600;
    line-height: 1.5;
  }
  .member p {
    margin: 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.7;
    overflow-wrap: anywhere;
  }
  @media (max-width: 640px) {
    .pi-profile {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: 20px;
    }
    .members-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .people-group + .people-group {
      margin-top: 36px;
    }
  }
  .scholar-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 42px;
    padding: 9px 16px;
    border: 1px solid #087e7833;
    border-radius: 8px;
    background: var(--bg);
    color: var(--accent);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.5;
    text-decoration: none;
  }
  .scholar-link:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: #087e7808;
  }
</style>
