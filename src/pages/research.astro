---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout title="Research Topics">
<section id="research" class="soft">
        <div class="wrap">
          <h1 class="section-title">Research Topics</h1>
          <div class="grid">
            <article class="card">
              <span class="number">01 / AGENT SECURITY</span>
              <h3>Agentic AI Security</h3>
              <p>
                Studying threats to AI agents and developing defenses for secure
                tool use, planning, and autonomous decision-making.
              </p>
            </article>
            <article class="card">
              <span class="number">02 / MULTI-AGENT SYSTEMS</span>
              <h3>Multi-Agent System Security</h3>
              <p>
                Investigating attacks and defenses in multi-agent systems, with
                a focus on secure communication, coordination, and
                collaboration.
              </p>
            </article>
            <article class="card">
              <span class="number">03 / RED-TEAMING</span>
              <h3>Automated AI Red-Teaming</h3>
              <p>
                Developing automated methods to discover vulnerabilities,
                evaluate safeguards, and assess the security of AI systems.
              </p>
            </article>
            <article class="card">
              <span class="number">04 / CYBERSECURITY</span>
              <h3>AI for Cybersecurity</h3>
              <p>
                We research applications of artificial intelligence in
                cybersecurity, with a particular focus on autonomous agents
                for cyber defense.
              </p>
            </article>
          </div>
        </div>
      </section>
</SiteLayout>
