---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout title="Research Topics">
  <section id="research" class="soft">
    <div class="wrap research-topics">
      <h1 class="section-title">Research Topics</h1>
      <fieldset class="research-options">
        <legend class="visually-hidden">Research area</legend>
        <div class="research-option">
          <input type="radio" name="research-area" id="research-safety" aria-controls="safety-topics" checked />
          <label for="research-safety">AI Safety and Security</label>
        </div>
        <div class="research-option">
          <input type="radio" name="research-area" id="research-cyber" aria-controls="cyber-topics" />
          <label for="research-cyber">AI for Cybersecurity</label>
        </div>
      </fieldset>
      <div id="safety-topics" class="research-panel" role="region" aria-labelledby="safety-heading">
        <h2 id="safety-heading" class="visually-hidden">AI Safety and Security</h2>
        <div class="grid">
          <article class="card">
            <span class="number">01 / AGENT SECURITY</span>
            <h3>Agentic AI Security</h3>
            <p>
              Studying threats to AI agents and developing defenses for secure
              tool use, planning, and autonomous decision-making.
            </p>
          </article>
          <article class="card">
            <span class="number">02 / MULTI-AGENT SYSTEMS</span>
            <h3>Multi-Agent System Security</h3>
            <p>
              Investigating attacks and defenses in multi-agent systems, with
              a focus on secure communication, coordination, and
              collaboration.
            </p>
          </article>
          <article class="card">
            <span class="number">03 / RED-TEAMING</span>
            <h3>Automated AI Red-Teaming</h3>
            <p>
              Developing automated methods to discover vulnerabilities,
              evaluate safeguards, and assess the security of AI systems.
            </p>
          </article>
        </div>
      </div>
      <div id="cyber-topics" class="research-panel" role="region" aria-labelledby="cyber-heading">
        <h2 id="cyber-heading" class="visually-hidden">AI for Cybersecurity</h2>
        <div class="grid">
          <article class="card">
            <span class="number">04 / CYBERSECURITY</span>
            <h3>AI for Cybersecurity</h3>
            <p>
              We research applications of artificial intelligence in
              cybersecurity, with a particular focus on autonomous agents
              for cyber defense.
            </p>
          </article>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .research-options {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding: 0;
    margin: 0 0 32px;
    border: 0;
    min-width: 0;
  }

  .research-option {
    position: relative;
  }

  .visually-hidden,
  .research-option input {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .research-option label {
    display: block;
    padding: 12px 20px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--bg);
    color: var(--muted);
    font-size: 14px;
    font-weight: 650;
    cursor: pointer;
  }

  .research-option label:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .research-option input:checked + label {
    border-color: var(--accent);
    background: var(--accent);
    color: white;
  }

  .research-option input:focus-visible + label {
    outline: 3px solid var(--accent);
    outline-offset: 5px;
  }

  .research-topics:has(#research-safety:checked) #cyber-topics,
  .research-topics:has(#research-cyber:checked) #safety-topics {
    display: none;
  }

  @media (max-width: 560px) {
    .research-option {
      flex: 1 1 100%;
    }

    .research-option label {
      text-align: center;
    }
  }
</style>
