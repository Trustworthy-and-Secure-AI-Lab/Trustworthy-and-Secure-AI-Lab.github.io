---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout title="Join the Lab">
  <section id="join" class="soft">
    <div class="wrap">
      <h1 class="section-title">Join the Lab</h1>
      <p class="lead">
        Our lab welcomes students interested in AI safety and security.
        We also explore how artificial intelligence can be used to strengthen
        cybersecurity. Explore our research topics and publications to learn
        more about the questions we study.
      </p>
      <div class="join-faq" aria-labelledby="faq-title">
        <h2 id="faq-title">Frequently Asked Questions</h2>
        <details>
          <summary>How can I apply to work with the lab?</summary>
          <div class="faq-answer">
            <p>To express your interest in working with the lab, please contact us at either of the following email addresses:</p>
            <ul class="contact-emails">
              <li><a href="mailto:sadeghzadeh@sharif.edu">sadeghzadeh@sharif.edu</a></li>
              <li><a href="mailto:amsadeghzadeh@gmail.com">amsadeghzadeh@gmail.com</a></li>
            </ul>
          </div>
        </details>
      </div>
    </div>
  </section>
</SiteLayout>
