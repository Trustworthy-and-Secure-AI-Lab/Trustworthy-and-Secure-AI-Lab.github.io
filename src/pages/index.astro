---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout>
<div class="hero">
        <div class="wrap">
          <div class="hero-layout">
            <div>
              <div class="home-affiliation">Sharif University of Technology &middot; Tehran, Iran</div>
              <h1>Trustworthy<br />and <em>Secure AI</em> Lab.</h1>
              <div class="hero-links">
                <a class="button hero-action" href="/research/">
                  Explore our research
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14m-6-6 6 6-6 6" />
                  </svg>
                </a>
                <a class="button hero-action hero-action-secondary" href="/people/">
                  <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="9" cy="8" r="3" />
                    <path d="M3 21v-2a6 6 0 0 1 12 0v2M16 5a3 3 0 0 1 0 6m3 10v-2a6 6 0 0 0-3-5.2" />
                  </svg>
                  Meet the team
                </a>
              </div>
            </div>
            <svg
              class="visual"
              viewBox="0 0 440 440"
              role="img"
              aria-labelledby="graphic-title"
            >
              <title id="graphic-title">
                Abstract shield surrounded by a network of connected nodes
              </title>
              <defs>
                <linearGradient
                  id="shield-gradient"
                  x1="0"
                  y1="0"
                  x2="1"
                  y2="1"
                >
                  <stop stop-color="#087e78" />
                  <stop offset="1" stop-color="#7661bd" />
                </linearGradient>
              </defs>
              <g fill="none" stroke="#087e78">
                <circle cx="220" cy="220" r="191" opacity=".12" />
                <circle
                  cx="220"
                  cy="220"
                  r="150"
                  opacity=".18"
                  stroke-dasharray="4 10"
                />
                <ellipse
                  cx="220"
                  cy="220"
                  rx="205"
                  ry="90"
                  transform="rotate(-35 220 220)"
                  opacity=".15"
                />
                <g opacity=".25">
                  <path
                    d="M64 104 158 149M359 103 282 149M48 269 162 247M389 291 278 248M151 397 200 305M314 371 249 300"
                  />
                </g>
              </g>
              <path
                d="M220 114 304 148V222C304 274 262 311 220 331C178 311 136 274 136 222V148Z"
                fill="#e7f5f0"
                stroke="url(#shield-gradient)"
                stroke-width="2"
              />
              <path
                d="M220 139 282 164V222C282 263 253 290 220 307C187 290 158 263 158 222V164Z"
                fill="none"
                stroke="#087e78"
                opacity=".23"
              />
              <path
                d="m184 222 25 25 49-54"
                fill="none"
                stroke="url(#shield-gradient)"
                stroke-width="8"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
              <g fill="#087e78">
                <circle cx="64" cy="104" r="6" />
                <circle cx="359" cy="103" r="5" />
                <circle cx="48" cy="269" r="5" />
                <circle cx="389" cy="291" r="7" />
                <circle cx="151" cy="397" r="5" />
              </g>
              <circle cx="314" cy="371" r="6" fill="#7661bd" />
              <g
                font-family="monospace"
                font-size="10"
                fill="#596a7e"
                letter-spacing="2"
              >
                <text x="17" y="85">SECURITY</text>
                <text x="303" y="80">PRIVACY</text>
                <text x="250" y="408">TRUST</text>
              </g>
            </svg>
          </div>
          <div class="hero-meta">
            <span>Security &amp; Privacy</span><span>Machine Learning</span
            ><span>AI for Cybersecurity</span>
          </div>
        </div>
      </div>
</SiteLayout>
